# Local demo: do not put secrets in a public repository.
RETAILMIND_API_URL=http://127.0.0.1:8000
RETAILMIND_RETRIEVAL=qdrant
# Optional: dense retrieval after 'pip install -e ".[rag]"' and 'retailmind index'
# RETAILMIND_RETRIEVAL=qdrant
# QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
RAG_CHUNK_TOKENS=96
RAG_CHUNK_OVERLAP=16
RAG_MIN_SCORE=0.2
# Without QDRANT_URL: persistent data/qdrant_local (one process at a time).
# QDRANT_PATH=C:/path/to/retailmind-ai/data/qdrant_local
# RETAILMIND_MODEL_CACHE=C:/path/to/retailmind-ai/data/embedding_cache
# Explicit offline fallback: RETAILMIND_RETRIEVAL=local
# Optional Ollama synthesis; base system works without any LLM
# RETAILMIND_OLLAMA_MODEL=qwen3:1.7b
# OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_TIMEOUT=20
# .env loaded by Python; existing process variables take precedence.
