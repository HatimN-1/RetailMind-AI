# Airflow runs the scheduler/UI; a second Python environment runs PySpark and dbt.
# Keeping these separate avoids upgrading Airflow's own Python dependencies.
FROM apache/airflow:2.10.5-python3.11

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    RETAILMIND_PYTHON=/opt/retailmind-venv/bin/python \
    RETAILMIND_DBT=/opt/retailmind-venv/bin/dbt

# Use an isolated venv for the V4 data pipeline. The repository is bind-mounted
# at runtime and made importable through PYTHONPATH in docker-compose.yml.
RUN python -m venv /opt/retailmind-venv \
    && PIP_USER=false /opt/retailmind-venv/bin/python -m pip install --no-cache-dir \
         'python-dotenv>=1.0,<2' 'pandas>=2.1,<3' 'numpy>=1.26,<3' \
         'pyspark==4.0.5' 'pyarrow==24.0.0' \
         'dbt-core==1.12.7' 'dbt-duckdb==1.11.1' 'duckdb==1.5.6'

USER airflow
# Retain the dependencies used by the legacy V3 Airflow DAG.
RUN pip install --no-cache-dir "apache-airflow==${AIRFLOW_VERSION}" \
    'pandas>=2.1,<3' 'numpy>=1.26,<3' 'scikit-learn>=1.4,<2' 'joblib>=1.3,<2'
